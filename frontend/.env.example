# Copy to .env and fill in the values. Never commit .env.
# Nuxt reads NUXT_PUBLIC_* into runtimeConfig.public.

# Supabase local stack (see `make supabase-status` in backend/).
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon (publishable) key is meant for the browser; never put the service key here.
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# Punto Vecinal API.
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080
