# Copy to .env and fill in the values. Never commit .env.
# Real environment variables take precedence over this file.

# --- App ---
APP_ENV=development
PORT=8080

# --- Database (Supabase Postgres) ---
# Local stack: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Set to true when connecting through the Supabase transaction pooler.
DATABASE_TRANSACTIONPOOL=false
# Pool tuning (0 or empty keeps the pgx default). Durations like 30m, 5s.
DATABASE_MAXCONNS=0
DATABASE_MINCONNS=0
DATABASE_MAXCONNLIFETIME=0s
DATABASE_MAXCONNIDLETIME=0s
DATABASE_CONNECTTIMEOUT=0s

# --- Supabase Auth ---
SUPABASE_URL=http://127.0.0.1:54321
# Both are required. JWKSURL has the public keys used to verify the Supabase JWT.
SUPABASE_JWKSURL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# --- Object storage (any S3-compatible server) ---
# Local default: RustFS started with `make storage-start` (console at http://127.0.0.1:9001/rustfs/console/).
# ENDPOINT, BUCKET, ACCESSKEY and SECRETKEY are required.
S3_ENDPOINT=http://127.0.0.1:9000
# Endpoint put in signed photo links, when browsers reach the server by another
# address than the API does. Empty means the same as S3_ENDPOINT.
S3_PUBLICENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=punto-vecinal
S3_ACCESSKEY=rustfsadmin
S3_SECRETKEY=rustfsadmin
# true for RustFS (host/bucket/key); most providers use false (bucket.host/key).
S3_FORCEPATHSTYLE=true
# Production examples (use a private bucket and real keys):
#   DigitalOcean Spaces: S3_ENDPOINT=https://nyc3.digitaloceanspaces.com  S3_REGION=nyc3  S3_FORCEPATHSTYLE=false
#   AWS S3:              S3_ENDPOINT=https://s3.us-east-1.amazonaws.com   S3_REGION=us-east-1  S3_FORCEPATHSTYLE=false
#   Cloudflare R2:       S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto

# --- Voyage AI (embeddings) ---
VOYAGE_APIKEY=
