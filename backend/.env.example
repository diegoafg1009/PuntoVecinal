# Copy to .env and fill in the values. Never commit .env.
# Real environment variables take precedence over this file.

# --- App ---
APP_ENV=development
PORT=8080

# --- Database (Supabase Postgres) ---
# Local stack: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Set to true when connecting through the Supabase transaction pooler.
DATABASE_TRANSACTIONPOOL=false
# Pool tuning (0 or empty keeps the pgx default). Durations like 30m, 5s.
DATABASE_MAXCONNS=0
DATABASE_MINCONNS=0
DATABASE_MAXCONNLIFETIME=0s
DATABASE_MAXCONNIDLETIME=0s
DATABASE_CONNECTTIMEOUT=0s

# --- Supabase Auth ---
SUPABASE_URL=http://127.0.0.1:54321
# Endpoint with the public keys used to verify the Supabase JWT.
SUPABASE_JWKSURL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# --- DigitalOcean Spaces (S3-compatible) ---
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_ACCESSKEY=
SPACES_SECRETKEY=

# --- Voyage AI (embeddings) ---
VOYAGE_APIKEY=
